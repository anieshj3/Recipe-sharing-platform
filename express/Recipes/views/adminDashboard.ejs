<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>

    <link rel="stylesheet" href="/stylesheets/adminDashboard.css">
</head>

<body>

<div class="container">

    <!-- Sidebar -->

    <div class="sidebar">

        <h2>RecipeShare</h2>

        <ul>

            <li><a href="/admin/dashboard">Dashboard</a></li>

            <li><a href="/admin/users">Users</a></li>

            <li><a href="/admin/user-management">User Management</a></li>

            <li><a href="/admin/recipes">Recipes</a></li>

            <li><a href="/admin/mostViewed">Most Viewed</a></li>

            <li><a href="/admin/login">Logout</a></li>

        </ul>

    </div>

    <!-- Main Content -->

    <div class="main-content">

        <div class="header">

            <h1>Admin Dashboard</h1>

            <p>Welcome Administrator</p>

        </div>

        <!-- Dashboard Cards -->

        <div class="cards">

            <div class="card">

                <h3>Total Users</h3>

                <h2>150</h2>

            </div>

            <div class="card">

                <h3>Total Recipes</h3>

                <h2>320</h2>

            </div>

            <div class="card">

                <h3>Total Views</h3>

                <h2>12,500</h2>

            </div>

            <div class="card">

                <h3>Categories</h3>

                <h2>18</h2>

            </div>

        </div>

        <!-- Recent Recipes -->

        <div class="table-section">

            <h2>Recent Recipes</h2>

            <table>

                <tr>

                    <th>ID</th>

                    <th>Recipe Name</th>

                    <th>Author</th>

                    <th>Category</th>

                    <th>Status</th>

                </tr>

                <tr>

                    <td>1</td>

                    <td>Chicken Biryani</td>

                    <td>John</td>

                    <td>Non-Veg</td>

                    <td>Published</td>

                </tr>

                <tr>

                    <td>2</td>

                    <td>Veg Fried Rice</td>

                    <td>Priya</td>

                    <td>Veg</td>

                    <td>Published</td>

                </tr>

                <tr>

                    <td>3</td>

                    <td>Paneer Butter Masala</td>

                    <td>Rahul</td>

                    <td>Veg</td>

                    <td>Pending</td>

                </tr>

                <tr>

                    <td>4</td>

                    <td>Fish Curry</td>

                    <td>David</td>

                    <td>Sea Food</td>

                    <td>Published</td>

                </tr>

            </table>

        </div>

    </div>

</div>

</body>

</html>